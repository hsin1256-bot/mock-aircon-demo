/**
 * ============================================================
 * 파일 경로: firmware/mock_aircon_receiver/secrets.h.example
 * ------------------------------------------------------------
 * 이 파일을 복사해 secrets.h로 저장한 뒤 실제 값으로 채우세요.
 *   cp secrets.h.example secrets.h
 * secrets.h는 .gitignore에 포함되어 있어 저장소에 커밋되지 않습니다.
 *
 * SERVER_HOST/PORT는 esp32-env-power-dashboard의 메인 백엔드가 아니라
 * 이 프로젝트 자체의 독립된 backend/server.js를 가리킨다. WIFI_SSID/
 * PASSWORD는 송신부(esp32_sensor_node)가 연결된 것과 같은 네트워크로
 * 맞춰야 서로 IR로 통신 가능한 범위에 있을 수 있다. DEVICE_TOKEN은
 * 이 프로젝트 backend/.env의 값과 동일해야 한다(esp32-env-power-
 * dashboard의 DEVICE_TOKEN과는 무관 - 완전히 별도 인증).
 * ============================================================
 */
#ifndef SECRETS_H
#define SECRETS_H

const char* WIFI_SSID      = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD  = "YOUR_WIFI_PASSWORD";
const char* SERVER_HOST    = "<이 프로젝트 backend/server.js가 도는 IP>";
const uint16_t SERVER_PORT = 4000;                  // backend/.env의 PORT와 동일
const char* SERVER_WS_PATH = "/ws";
const char* DEVICE_TOKEN   = "<backend/.env의 DEVICE_TOKEN과 동일한 값>";

#endif
